# Analytics Service - Environment Configuration Template
# Copy this to .env and adjust values for your environment

# Service Configuration
SERVICE_NAME=analytics-service
SERVICE_PORT=3003
SERVICE_HOST=0.0.0.0
DEBUG=false

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_ORDER_EVENTS_TOPIC=order-events
KAFKA_INVENTORY_EVENTS_TOPIC=inventory-events
KAFKA_METRICS_TOPIC=metrics-events
KAFKA_FORECAST_TOPIC=forecast-events
KAFKA_CONSUMER_GROUP=analytics-service
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=10000

# Database Configuration
DB_PATH=./data/analytics.duckdb
DB_PARQUET_PATH=./data/parquet

# OpenTelemetry / Jaeger Configuration
OTEL_ENABLED=false
JAEGER_HOST=localhost
JAEGER_PORT=6831

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Analytics Configuration
METRICS_CACHE_TTL_SECONDS=300
FORECAST_DAYS_DEFAULT=30
FORECAST_DAYS_MAX=365
DAILY_REPORT_HOUR=0
DAILY_REPORT_MINUTE=0

# Performance Configuration
CONSUMER_BATCH_SIZE=100
CONSUMER_BATCH_TIMEOUT_MS=5000
